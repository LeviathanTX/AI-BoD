# AI-BoD Environment Variables
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# REQUIRED: AI Service API Keys
# =============================================================================
# At least one AI service API key is required for the application to function.
# The app will automatically use server-side proxy if no local key is configured.

# Claude (Anthropic) - Default AI service
REACT_APP_CLAUDE_API_KEY=

# OpenAI (ChatGPT) - Used for GPT-5.2 and other OpenAI models
OPENAI_API_KEY=

# =============================================================================
# AWS BEDROCK - Multi-Model AI Routing
# =============================================================================
# AWS Bedrock provides access to multiple AI model families (Claude, Llama, Mistral, Nova)
# Required for multi-model advisor routing to work

# AWS Access Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# =============================================================================
# Supabase - Backend Database & Auth
# =============================================================================

REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# =============================================================================
# Voice & Audio Services
# =============================================================================

# Deepgram - Voice transcription and analysis
REACT_APP_DEEPGRAM_API_KEY=

# =============================================================================
# Optional: Additional AI Services
# =============================================================================

# Google Gemini
REACT_APP_GEMINI_API_KEY=

# DeepSeek
REACT_APP_DEEPSEEK_API_KEY=

# Groq
REACT_APP_GROQ_API_KEY=

# =============================================================================
# NOTES
# =============================================================================
#
# Multi-Model Architecture:
# ------------------------
# The app uses AWS Bedrock to route different advisors to different AI models:
#
# TIER 1 (Premium Advisors):
#   - Jeff (Host): Amazon Nova Micro ($0.035/1M tokens) - Ultra-low cost for routing
#   - Reed Pawffman: OpenAI GPT-5.2 - Best quality strategic advice
#   - Jason Clawcanis: Mistral Large - Direct/contrarian investor persona
#   - Marc Beardreessen: Claude Sonnet 4 - Technology-optimist depth
#   - Cheryl Sandbearg: Amazon Nova Pro - Analytical operational excellence
#
# TIER 2 (Functional Advisors):
#   - All strategic/functional advisors: Meta Llama 3.3 70B ($0.72/1M tokens)
#   - Direct, analytical advice with reduced sycophancy
#
# TIER 3 (Industry Specialists):
#   - All industry specialists: Amazon Nova Pro ($0.80/1M tokens)
#   - Cost-optimized specialist knowledge
#
# Cost Savings:
# Using multi-model routing reduces costs by ~84% compared to using GPT-4
# for all advisors while increasing diversity of opinion and reducing
# AI sycophancy through model variety.
#
